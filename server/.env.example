# ─── Server ───────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── Datastores ───────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/safetrack
REDIS_URL=redis://localhost:6379

# ─── Firebase (Auth + Cloud Messaging) ────────────────────
FIREBASE_PROJECT_ID=safetrack-pulse
FIREBASE_CLIENT_EMAIL=your-service-account@safetrack-pulse.iam.gserviceaccount.com
# Keep the literal \n escapes if pasting a single-line private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Payments ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Or Stripe, if used instead of Razorpay
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ─── SMS fallback (SOS dispatch) ──────────────────────────
SMS_PROVIDER_KEY=your-sms-provider-api-key

# ─── Realtime tuning ──────────────────────────────────────
LOCATION_FLUSH_INTERVAL_MS=10000
STRAGGLER_THRESHOLD_M=1500
